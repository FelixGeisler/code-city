{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://felixgeisler.github.io/code-city/schema/evolution-bundle-1.0.schema.json",
  "title": "Code City EvolutionBundle 1.0",
  "description": "A bounded, deterministic, privacy-preserving sequence of one complete CityModel baseline and explicit entity deltas.",
  "$comment": "Frame/SHA alignment, first-parent adjacency for unsampled histories, exact change-kind classification, operation overlap, no-op changes, lineage limits, cross-references, replayed CityModel validity, and the recursive 64 KiB encoded UTF-8 limit for every JSON string and property name are additionally enforced by validateEvolutionBundle().",
  "type": "object",
  "required": [
    "schemaVersion",
    "generator",
    "authorPolicy",
    "selection",
    "provenance",
    "baseline",
    "deltas"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "authorPolicy": {
      "const": "omit-v1"
    },
    "selection": {
      "oneOf": [
        {
          "$ref": "#/$defs/rootToTipSelection"
        },
        {
          "$ref": "#/$defs/commitCountSelection"
        },
        {
          "$ref": "#/$defs/dateRangeSelection"
        },
        {
          "$ref": "#/$defs/tagRangeSelection"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "deltas": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "$ref": "#/$defs/deltaFrame"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F]"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F]"
      }
    },
    "gitSha": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "code-city"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "selectionBase": {
      "type": "object",
      "required": [
        "mode",
        "traversal",
        "order",
        "selectedCommitCount",
        "sampledCommitCount",
        "traversedCommitCount",
        "resolvedOldestSha",
        "resolvedNewestSha",
        "sampledCommitShas"
      ],
      "properties": {
        "mode": {
          "enum": [
            "root-to-tip",
            "commit-count",
            "date-range",
            "tag-range"
          ]
        },
        "traversal": {
          "const": "first-parent"
        },
        "order": {
          "const": "oldest-first"
        },
        "selectedCommitCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "sampledCommitCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "traversedCommitCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "resolvedOldestSha": {
          "$ref": "#/$defs/gitSha"
        },
        "resolvedNewestSha": {
          "$ref": "#/$defs/gitSha"
        },
        "sampledCommitShas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gitSha"
          }
        }
      }
    },
    "rootToTipSelection": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/selectionBase"
        },
        {
          "type": "object",
          "required": [
            "samplingStrategy",
            "maxFrames"
          ],
          "properties": {
            "mode": {
              "const": "root-to-tip"
            },
            "samplingStrategy": {
              "enum": [
                "evenly-spaced-v1",
                "elapsed-time-v1"
              ]
            },
            "maxFrames": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "commitCountSelection": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/selectionBase"
        },
        {
          "type": "object",
          "required": [
            "sampleEvery",
            "requestedCommitCount"
          ],
          "properties": {
            "mode": {
              "const": "commit-count"
            },
            "sampleEvery": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "selectedCommitCount": {
              "type": "integer",
              "maximum": 500
            },
            "traversedCommitCount": {
              "type": "integer",
              "maximum": 500
            },
            "requestedCommitCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dateRangeSelection": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/selectionBase"
        },
        {
          "type": "object",
          "required": [
            "sampleEvery",
            "fromInclusive",
            "toInclusive"
          ],
          "properties": {
            "mode": {
              "const": "date-range"
            },
            "sampleEvery": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "selectedCommitCount": {
              "type": "integer",
              "maximum": 500
            },
            "traversedCommitCount": {
              "type": "integer",
              "maximum": 500
            },
            "fromInclusive": {
              "$ref": "#/$defs/instant"
            },
            "toInclusive": {
              "$ref": "#/$defs/instant"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tagRangeSelection": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/selectionBase"
        },
        {
          "type": "object",
          "required": [
            "sampleEvery"
          ],
          "properties": {
            "mode": {
              "const": "tag-range"
            },
            "sampleEvery": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "selectedCommitCount": {
              "type": "integer",
              "maximum": 500
            },
            "traversedCommitCount": {
              "type": "integer",
              "maximum": 500
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "repositoryId",
        "repositoryFingerprint",
        "analyzer",
        "historyBackend",
        "metricConfigurationFingerprint",
        "selectionFingerprint"
      ],
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/identifier"
        },
        "repositoryFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "analyzer": {
          "type": "object",
          "required": [
            "name",
            "version",
            "fingerprint"
          ],
          "properties": {
            "name": {
              "const": "code-city"
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          },
          "additionalProperties": false
        },
        "historyBackend": {
          "type": "object",
          "required": [
            "name",
            "version",
            "renamePolicyRevision"
          ],
          "properties": {
            "name": {
              "const": "git"
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "renamePolicyRevision": {
              "$ref": "#/$defs/version"
            }
          },
          "additionalProperties": false
        },
        "metricConfigurationFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "selectionFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": [
        "index",
        "sha",
        "committedAt",
        "parentShas",
        "analyzerVersion",
        "analysisFingerprint"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "sha": {
          "$ref": "#/$defs/gitSha"
        },
        "committedAt": {
          "$ref": "#/$defs/instant"
        },
        "parentShas": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gitSha"
          }
        },
        "analyzerVersion": {
          "$ref": "#/$defs/version"
        },
        "analysisFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "additionalProperties": false
    },
    "modelChanges": {
      "type": "object",
      "properties": {
        "metricMapping": {
          "anyOf": [
            {
              "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/metricMapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/analysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "identityPanel": {
          "anyOf": [
            {
              "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/identityPanel"
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "anyOf": [
            {
              "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/base"
            },
            {
              "type": "null"
            }
          ]
        },
        "bounds": {
          "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/nonNegativeVector"
        }
      },
      "additionalProperties": false
    },
    "changeKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "renamed",
          "moved",
          "metrics",
          "relationships",
          "geometry",
          "metadata"
        ]
      }
    },
    "replacementBase": {
      "type": "object",
      "required": [
        "id",
        "changeKinds",
        "entity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "changeKinds": {
          "$ref": "#/$defs/changeKinds"
        },
        "entity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "entityDeltaBase": {
      "type": "object",
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "changed": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/replacementBase"
          }
        }
      },
      "additionalProperties": false
    },
    "repositoryDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/repository"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 1000
        },
        "changed": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/repository"
              }
            }
          }
        }
      }
    },
    "solutionDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/solution"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 5000
        },
        "changed": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/solution"
              }
            }
          }
        }
      }
    },
    "moduleDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/module"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 10000
        },
        "changed": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/module"
              }
            }
          }
        }
      }
    },
    "semanticGroupDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/semanticGroup"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 256
        },
        "changed": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/semanticGroup"
              }
            }
          }
        }
      }
    },
    "districtDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/district"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 10000
        },
        "changed": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/district"
              }
            }
          }
        }
      }
    },
    "buildingDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/building"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 25000
        },
        "changed": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/building"
              }
            }
          }
        }
      }
    },
    "dependencyDelta": {
      "allOf": [
        {
          "$ref": "#/$defs/entityDeltaBase"
        }
      ],
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/dependency"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 100000
        },
        "changed": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/replacementBase"
              }
            ],
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json#/$defs/dependency"
              }
            }
          }
        }
      }
    },
    "changes": {
      "type": "object",
      "required": [
        "model",
        "repositories",
        "solutions",
        "modules",
        "semanticGroups",
        "districts",
        "buildings",
        "dependencies"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/modelChanges"
        },
        "repositories": {
          "$ref": "#/$defs/repositoryDelta"
        },
        "solutions": {
          "$ref": "#/$defs/solutionDelta"
        },
        "modules": {
          "$ref": "#/$defs/moduleDelta"
        },
        "semanticGroups": {
          "$ref": "#/$defs/semanticGroupDelta"
        },
        "districts": {
          "$ref": "#/$defs/districtDelta"
        },
        "buildings": {
          "$ref": "#/$defs/buildingDelta"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyDelta"
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": [
        "commit",
        "model"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "model": {
          "$ref": "https://felixgeisler.github.io/code-city/schema/city-model-1.0.schema.json"
        }
      },
      "additionalProperties": false
    },
    "deltaFrame": {
      "type": "object",
      "required": [
        "commit",
        "changes"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "changes": {
          "$ref": "#/$defs/changes"
        }
      },
      "additionalProperties": false
    }
  }
}
