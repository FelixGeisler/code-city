{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-city.dev/schema/advanced-query/1",
  "title": "Code City advanced query",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ruleSchema", "all"],
  "properties": {
    "version": { "const": "codecity.advanced-query/1" },
    "ruleSchema": { "const": "codecity.query-rules/1" },
    "name": { "type": "string", "maxLength": 120 },
    "scope": { "enum": ["whole-city", "selected"] },
    "all": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator", "value"],
        "properties": {
          "field": { "enum": ["name", "path", "language", "risk", "sloc", "decisionLoad", "maximumComplexity", "incomingDependencies", "outgoingDependencies", "changedRecently", "smell"] },
          "operator": { "enum": ["contains", "equals", "atLeast", "atMost"] },
          "value": { "type": ["string", "number"] }
        }
      }
    }
  }
}
