{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-city.dev/schema/safe-extension/1",
  "title": "Code City safe declarative extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "compatibility", "scope"],
  "properties": {
    "version": { "const": "codecity.extensions/1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["cityModel", "capabilities"],
      "properties": {
        "cityModel": { "const": "1.x" },
        "capabilities": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "enum": ["derived-metrics", "mappings", "filters", "legends", "layouts", "queries", "overlays"] } }
      }
    },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "project" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "approvalId"], "properties": { "kind": { "const": "administrator" }, "approvalId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } } }
      ]
    },
    "derivedMetrics": { "$ref": "#/$defs/definitions" },
    "mappings": { "$ref": "#/$defs/definitions" },
    "filters": { "$ref": "#/$defs/definitions" },
    "legends": { "$ref": "#/$defs/definitions" },
    "layouts": { "$ref": "#/$defs/definitions" },
    "queries": { "$ref": "#/$defs/definitions" },
    "overlays": { "$ref": "#/$defs/definitions" }
  },
  "$defs": {
    "definitions": { "type": "array", "maxItems": 32, "items": { "type": "object" } }
  }
}
